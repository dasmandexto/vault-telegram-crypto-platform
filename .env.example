# Токен Telegram-бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram ID администратора (можно несколько через запятую)
ADMIN_IDS=123456789,987654321

# Секретный ключ для JWT авторизации
SECRET_KEY=super-secret-crypto-vault-key-change-in-production

# Пароль администратора для входа в веб-панель
ADMIN_PASSWORD=admin_secret_password_2026

# Хост и порт для запуска FastAPI сервера
HOST=0.0.0.0
PORT=8000

# Внешний HTTPS URL вашего приложения (например: https://vault.yourdomain.com)
# Необходим для корректной работы Telegram WebApp
WEBAPP_URL=https://vault.yourdomain.com
